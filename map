  #toolbar .btn:hover { background:#4a6a9e; }
  #legend {
    position:fixed; top:74px; right:16px; background:#fff; border:1px solid #ccc; border-radius:6px;
    padding:10px 14px; font-size:11px; color:#333; z-index:40; box-shadow:0 2px 6px rgba(0,0,0,.15); max-width:250px;
  }
  #legend b { display:block; margin-bottom:6px; color:#1F3864; font-size:12px; }
  .lg-row { display:flex; align-items:center; gap:6px; margin:3px 0; }
  .lg-swatch { width:12px; height:12px; border-radius:3px; flex:none; }
  #hint { position:fixed; bottom:12px; left:16px; background:#fff; border:1px solid #ccc; border-radius:6px; padding:8px 12px; font-size:11px; color:#555; z-index:40; box-shadow:0 2px 6px rgba(0,0,0,.15); }
  #stage { position:absolute; top:0; left:0; cursor:grab; }
  #stage.grabbing { cursor:grabbing; }
  #world { position:absolute; top:0; left:0; transform-origin: 0 0; }
  svg#edges { position:absolute; top:0; left:0; overflow:visible; }
  .card { position:absolute; border-radius:7px; border:1.4px solid; padding:7px 9px; width:172px; background:#fff; box-shadow:0 1px 3px rgba(0,0,0,.15); font-size:10.5px; cursor:pointer; transition: opacity .15s, box-shadow .15s; }
  .card:hover { box-shadow:0 3px 10px rgba(0,0,0,.25); }
  .card .sym { font-family: Consolas, monospace; font-weight:bold; font-size:10.5px; }
  .card .name { font-size:9.8px; color:#333; margin-top:2px; line-height:1.2; }
  .card .formula { font-family: Consolas, monospace; font-size:9px; color:#555; margin-top:4px; border-top:1px dashed #ccc; padding-top:3px; line-height:1.25; }
  .card.gap { border-style: dashed; border-color:#9C0006; }
  .card.hub0 { width:200px; padding:12px 14px; background:#1F3864; border-color:#0d1c33; }
  .card.hub1 { width:186px; padding:10px 12px; background:#33507e; border-color:#1F3864; }
  .card.cluster { width:176px; padding:9px 11px; background:#e9edf5; border-color:#7f92b3; }
  .card.hub0 .sym, .card.hub0 .name, .card.hub1 .sym, .card.hub1 .name { color:#fff; }
  .card.hub0 .formula, .card.hub1 .formula { color:#c7d2e6; border-top-color:#4a6a9e; }
  .card.cluster .sym { color:#1F3864; }
  .card.cluster .name { color:#3d4a63; }
  .dimmed { opacity:.1; }
  .edge-path { fill:none; stroke:#9AA5B1; stroke-width:1; opacity:.35; }
  .edge-path.bc { stroke-dasharray:4 3; stroke:#0F6E56; opacity:.4; }
  .edge-path.cross { stroke:#993C1D; stroke-dasharray:2 3; opacity:.4; }
  .edge-path.hi { stroke:#D85A30 !important; stroke-width:2; opacity:.95 !important; stroke-dasharray:none !important; }
</style>
</head>
<body>

<div id="toolbar">
  <h1>Texas M&amp;O funding variable tree</h1>
  <input type="text" id="search" placeholder="Find a variable...">
  <button class="btn" id="resetBtn">Reset view</button>
  <button class="btn" id="zoomIn">+</button>
  <button class="btn" id="zoomOut">&minus;</button>
</div>

<div id="legend">
  <b>Reading this</b>
  <div class="lg-row"><span class="lg-swatch" style="background:#1F3864"></span> Root: Total M&amp;O Funding</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#33507e"></span> Aggregation hub (WADA, ADA_reg, etc.)</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#e9edf5;border:1px solid #7f92b3"></span> Category cluster</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#fff;border:1.4px dashed #9C0006"></span> Gap / placeholder</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#9AA5B1;height:2px;border-radius:0"></span> Solid = nests under this parent</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#0F6E56;height:2px;border-radius:0"></span> Dashed teal = also sums into WADA</div>
  <div class="lg-row"><span class="lg-swatch" style="background:#993C1D;height:2px;border-radius:0"></span> Dashed rust = cross-branch input</div>
  <div style="margin-top:6px;color:#777">Click a box to trace it. A separate "Foundational inputs" tree sits below/left - these are raw inputs used across many branches.</div>
</div>

<div id="hint">Umbrella view: hubs at top, contributing variables nest below &middot; click any box to trace it</div>

<div id="stage">
  <div id="world"><svg id="edges"></svg></div>
</div>

<script>
// ---------- Node content ----------
const HUBS = {
  TotalMO:        {name:"Total M&O Funding", formula:"Tier One + Tier Two + ASF + IMTA + Other Programs", level:0},
  TierOneTotal:   {name:"Total Cost of Tier One", formula:"sum of every Tier One allotment below", level:1},
  TierTwoTotal:   {name:"Tier Two Guaranteed Yield", formula:"yield x WADA x tax rate, minus local share", level:1},
  ASFTotal:       {name:"ASF Distribution", formula:"rate_asf x ADA_asf", level:1},
  IMTATotal:      {name:"IMTA Total", formula:"rate_imta x ENR + rate_imta_eb x ENR_eb", level:1},
  OtherProgramsTotal: {name:"Other Programs Total", formula:"sum of Other Programs line items", level:1},
  WADA:           {name:"Weighted ADA", formula:"sum of Subch. B/C allotments / BA_adj", level:2},
  ADA_reg:        {name:"Regular Program ADA", formula:"ADA_ref minus FTE_sped_agg minus FTE_cte_agg", level:3},
  ADA_ref:        {name:"Refined ADA", formula:"measured, per student, six six-weeks", level:4},
  FTE_sped_agg:   {name:"SpEd FTE (aggregate)", formula:"sum of 9 arrangement FTEs", level:4},
  FTE_cte_agg:    {name:"CTE FTE (aggregate)", formula:"sum of 3 CTE FTE tiers", level:4},
