const LEAVES = {
  w_reg:["Regular Program weight","ADA_reg x 1.00 x BA_adj",false],
  ADJ_smallmid:["Small/Mid-Size Adj.","sliding scale vs. 1,600 / 5,000 ADA",false],
  w_nonpublic:["Non-Public Contracts weight","ADA_nonpublic x 1.7 x BA_adj",false],
