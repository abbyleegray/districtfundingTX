  w_noneb_dl2way:["Non-EB Dual Lang 2-Way","ADA_noneb_dl x 0.05 x BA_adj",false],
  w_eb_altlang_dl:["EB Alt. Lang DL weight","additive 0.05, combines to 0.15",false],
  w_noneb_altlang_dl:["Non-EB Alt. Lang DL weight","ADA x 0.05 x BA_adj",false],
  cap_altlang_dl:["Alt. Lang DL statewide cap","$10M per biennium cap",false],
  w_k3_predk:["K-3 pre-PreK weight","ADA_k3predk x 0.10 x BA_adj",false],
  ALLOT_prek:["Full-day Pre-K allotment","BA_adj x ADA_prek (carve-out)",false],
  w_k3_all:["K-3 All Students weight","ADA_k3all x 0.01 x BA_adj",false],
  w_gt:["G/T weight","ADA_gt x 0.07 x BA_adj",false],
  cap_gt_pct:["G/T enrollment cap %","5% of district ADA ceiling",false],
  cap_gt_total:["G/T statewide cap","$100M/yr, binding this run",false],
  ADJ_gt_setaside:["G/T Set-Aside","statewide deduction",false],
  rate_ccmr_ed:["CCMR Ed-Disadv. bonus","$5,000 per graduate",false],
  rate_ccmr_noted:["CCMR Not-Ed-Disadv. bonus","$3,000 per graduate",false],
  rate_ccmr_sped:["CCMR SpEd bonus","$4,000 per graduate",false],
  rate_tia_master:["TIA Master rate","$12,000-$36,000 per teacher",true],
  rate_tia_exemplary:["TIA Exemplary rate","$6,000-$25,000 per teacher",true],
  rate_tia_recognized:["TIA Recognized rate","$3,000-$15,000 per teacher",true],
  rate_ssa_ada:["School Safety per ADA","ADA_ref x $21.10",false],
  rate_ssa_campus:["School Safety per campus","Count_campuses x $33,540",false],
  rate_trans_reg:["Regular transportation","Miles_reg x $1.08/mile",false],
  rate_trans_private:["Private transportation","rate not published",true],
  rate_trans_sped:["SpEd transportation","Miles_sped x $1.13/mile",false],
  rate_trans_cte:["CTE transportation","rate not published",true],
  rate_dropout:["Dropout Recovery rate","ADA_dropout x $275",false],
  rate_resplacement:["Residential Placement rate","ADA_resplacement x $275",false],
  rate_tuition_gap:["Tuition Allotment","rate not published",true],
  rate_collegeprep_gap:["College Prep Reimb.","rate not published",true],
  rate_certexam_gap:["Cert. Exam Reimb.","rate not published",true],
  w_rpep_ed:["R-PEP Ed-Disadv. weight","ADA_rpep_ed x 1.15 x BA_adj",false],
  w_rpep_noted:["R-PEP Non-Ed-Disadv. weight","ADA_rpep_noted x 1.11 x BA_adj",false],
  rate_rpep_grad_ed:["R-PEP grad bonus (Ed)","$1,500 per graduate",false],
  rate_rpep_grad_noted:["R-PEP grad bonus (Not)","$700 per graduate",false],
  rate_rpep_grad_sped:["R-PEP grad bonus (SpEd)","$1,500 per graduate",false],
